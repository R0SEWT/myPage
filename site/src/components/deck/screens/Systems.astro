---
import { SCREENS, systems } from '../../../data/deck';
import SecHead from '../SecHead.astro';

const s = SCREENS[2];
const { lead, prototype } = systems;
---
<section
  class="screen screen--systems"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <SecHead label={s.label} index={2} />

  <div class="lead">
    <div class="eyebrow eyebrow--live">{lead.eyebrow}</div>
    <h3 class="lead-title">{lead.title}</h3>
    <p class="lead-lede">{lead.lede}</p>
    <p class="lead-note">{lead.note}</p>
  </div>

  <div class="media-row">
    <div>
      <div class="eyebrow">{prototype.eyebrow}</div>
      <h3 class="media-title">{prototype.title}</h3>
      <p class="media-desc">{prototype.desc}</p>
      <div class="media-meta">{prototype.meta}</div>
    </div>

    <div class="media-frame">
      <video
        src={prototype.video}
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        aria-label={prototype.videoLabel}
      ></video>
      <div class="media-caption">{prototype.caption}</div>
    </div>
  </div>
</section>
