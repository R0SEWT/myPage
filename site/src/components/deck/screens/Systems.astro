---
import { SCREENS, systems } from '../../../data/deck';
import SecHead from '../SecHead.astro';
import T from '../T.astro';

const i = 1;
const s = SCREENS[i];
const { lead, prototype } = systems;
---
<section
  class="screen screen--systems"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <SecHead label={s.label} index={i} />

  <div class="lead">
    <T t={lead.eyebrow} as="div" class="eyebrow eyebrow--live" />
    <T t={lead.title} as="h3" class="lead-title" />
    <T t={lead.lede} as="p" class="lead-lede" />
    <T t={lead.note} as="p" class="lead-note" />
  </div>

  <div class="media-row">
    <div>
      <T t={prototype.eyebrow} as="div" class="eyebrow" />
      <T t={prototype.title} as="h3" class="media-title" />
      <T t={prototype.desc} as="p" class="media-desc" />
      <T t={prototype.meta} as="div" class="media-meta" />
    </div>

    <div class="media-frame">
      <video
        src={prototype.video}
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        aria-label={prototype.videoLabel.es}
        data-i18n="aria-label"
        data-es={prototype.videoLabel.es}
        data-en={prototype.videoLabel.en}
      ></video>
      <T t={prototype.caption} as="div" class="media-caption" />
    </div>
  </div>
</section>
