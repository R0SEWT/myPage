---
import { SCREENS, career } from '../../../data/deck';
import T from '../T.astro';
import SecHead from '../SecHead.astro';

const s = SCREENS[5];
---
<section
  class="screen screen--career"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <SecHead label={s.label} index={5} />

  {career.map((row) => (
    <div class="lin-row">
      <T t={row.when} class={row.current ? 'lin-when lin-when--now' : 'lin-when'} />
      <span>
        <T t={row.role} class="lin-role" />
        <span class="lin-org">{row.org}</span>
      </span>
      <T t={row.desc} class="lin-desc" />
    </div>
  ))}
</section>
