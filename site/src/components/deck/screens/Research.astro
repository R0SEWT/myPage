---
import { SCREENS, research } from '../../../data/deck';
import SecHead from '../SecHead.astro';

const s = SCREENS[3];
const { program, publication } = research;
---
<section
  class="screen screen--research"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <SecHead label={s.label} index={3} />

  <div class="lead">
    <div class="eyebrow eyebrow--live">{program.eyebrow}</div>
    <h3 class="lead-title lead-title--wide">{program.title}</h3>
    <p class="lead-desc">{program.desc}</p>
    <div class="media-meta">{program.meta}</div>
  </div>

  <div class="pub-row">
    <a class="pub-cover" href={publication.doi} target="_blank" rel="noopener noreferrer">
      <img src={publication.cover} alt={publication.coverAlt} width="283" height="366" />
    </a>

    <div>
      <div class="eyebrow">{publication.eyebrow}</div>
      <h3 class="media-title">{publication.title}</h3>
      <p class="media-desc">{publication.desc}</p>
    </div>

    <a class="pub-doi" href={publication.doi} target="_blank" rel="noopener noreferrer">
      {publication.doiLabel}
    </a>
  </div>
</section>
