---
import { SCREENS, research } from '../../../data/deck';
import SecHead from '../SecHead.astro';
import T from '../T.astro';
import { Image } from 'astro:assets';

const i = 2;
const s = SCREENS[i];
const { program, publication } = research;
---
<section
  class="screen screen--research"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <SecHead label={s.label} index={i} />

  <div class="lead">
    <T t={program.eyebrow} as="div" class="eyebrow eyebrow--live" />
    <T t={program.title} as="h3" class="lead-title lead-title--wide" />
    <T t={program.desc} as="p" class="lead-desc" />
    <T t={program.meta} as="div" class="media-meta" />
  </div>

  <div class="media-row media-row--pub">
  <div class="pub-row">
    <a class="pub-cover" href={publication.doi} target="_blank" rel="noopener noreferrer">
      {/* Shown at ~78px wide, so 2x that is all a sharp screen needs; lazy,
          because this screen is not the one the deck opens on. */}
      <Image
        src={publication.cover}
        alt={publication.coverAlt.es}
        data-i18n="alt"
        data-es={publication.coverAlt.es}
        data-en={publication.coverAlt.en}
        widths={[160, 240, 300]}
        sizes="(max-width: 1125px) 68px, (max-width: 1375px) 120px, 140px"
        format="webp"
        loading="lazy"
        decoding="async"
      />
    </a>

    <div>
      <T t={publication.eyebrow} as="div" class="eyebrow eyebrow--live" />
      <T t={publication.title} as="h3" class="media-title" />
      <T t={publication.desc} as="p" class="media-desc" />
    </div>

    <a class="pub-doi" href={publication.doi} target="_blank" rel="noopener noreferrer">
      {publication.doiLabel}
    </a>
  </div>

  <div class="media-frame signs-frame" data-signs>
    <canvas
      role="img"
      aria-label={publication.signs.label.es}
      data-i18n="aria-label"
      data-es={publication.signs.label.es}
      data-en={publication.signs.label.en}
    ></canvas>
    <T t={publication.signs.caption} as="div" class="media-caption" />
    <button type="button" class="media-toggle is-paused" data-signs-toggle aria-label="Reproducir animación">
      <span class="media-toggle-pause" aria-hidden="true">❚❚</span>
      <span class="media-toggle-play" aria-hidden="true">▶</span>
    </button>
  </div>
  </div>
</section>
