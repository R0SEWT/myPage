---
import { SCREENS, research } from '../../../data/deck';
import SecHead from '../SecHead.astro';
import T from '../T.astro';
import { Image } from 'astro:assets';

const i = 2;
const s = SCREENS[i];
const { program, publication } = research;
---
<section
  class="screen screen--research"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <SecHead label={s.label} index={i} />

  {/* Imitator leads: the field behind this screen performs it (signer.ts),
      so the copy the eye lands on first names what the figure is doing. The
      attention audit had put this move at 44% predicted attention for the
      publication against the thesis dropping from 0.40 to 0.17; the author
      took that trade once the field started telling Imitator. */}
  <div class="lead">
    <div class="pub-row pub-row--lead">
      <a class="pub-cover" href={publication.doi} target="_blank" rel="noopener noreferrer">
        {/* Lazy, because this screen is not the one the deck opens on. */}
        <Image
          src={publication.cover}
          alt={publication.coverAlt.es}
          data-i18n="alt"
          data-es={publication.coverAlt.es}
          data-en={publication.coverAlt.en}
          widths={[160, 240, 300]}
          sizes="(max-width: 1125px) 68px, (max-width: 1375px) 120px, 140px"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </a>

      <div>
        <T t={publication.eyebrow} as="div" class="eyebrow eyebrow--live" />
        <T t={publication.title} as="h3" class="media-title" />
        <T t={publication.desc} as="p" class="media-desc" />
        <T t={publication.background} as="div" class="media-meta" />
      </div>

      <a class="pub-doi" href={publication.doi} target="_blank" rel="noopener noreferrer">
        {publication.doiLabel}
      </a>
    </div>
  </div>

  <div class="research-second">
    <T t={program.eyebrow} as="div" class="eyebrow" />
    <T t={program.title} as="h3" class="media-title" />
    <T t={program.desc} as="p" class="media-desc" />
    <T t={program.meta} as="div" class="media-meta" />
  </div>
</section>
