---
import { SCREENS, lineage } from '../../../data/deck';
import T from '../T.astro';

const s = SCREENS[4];
---
<section
  class="screen screen--lineage"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <div class="sec-head"><T t={s.label} /></div>

  {lineage.map((row) => (
    <div class="lin-row">
      <T t={row.when} class={row.current ? 'lin-when lin-when--now' : 'lin-when'} />
      <span>
        <span class="lin-role">{row.role}</span>
        <span class="lin-org">{row.org}</span>
      </span>
      <T t={row.desc} class="lin-desc" />
    </div>
  ))}
</section>
