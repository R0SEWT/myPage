---
import { SCREENS, chrome, contact, links } from '../../../data/deck';
import T from '../T.astro';

const s = SCREENS[6];
---
<section
  class="screen screen--contact"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <div class="ct-status">
    <span class="dot" aria-hidden="true"></span><T t={contact.status} />
    <b aria-hidden="true">006</b>
  </div>

  <T t={contact.title} as="h2" class="ct-title" />

  <span class="copy-wrap">
    <a class="ct-mail" href={`mailto:${links.email}`} data-copy={links.email}>{links.email}</a>
    <span class="copy-live" role="status"><T t={chrome.copied} class="copy-flag" /></span>
  </span>

  {/* The CV is the action this screen exists for, so it gets the same
      buttons as the hero rather than a 10px tracked text link, and sits right
      under the address, where the eye already is: at the foot of the screen
      the links drew ~5x less predicted attention than their area. */}
  <div class="ct-actions">
    <a class="btn-recruiter" href={links.cvEn} download="Rody-Vilchez-CV-en.pdf" aria-label="Descargar CV en inglés" data-i18n="aria-label" data-es="Descargar CV en inglés" data-en="Download CV in English">
      <span class="btn-icon" aria-hidden="true">↓</span>
      <span>CV (EN)</span>
    </a>
    <a class="btn-recruiter" href={links.cvEs} download="Rody-Vilchez-CV-es.pdf" aria-label="Descargar CV en español" data-i18n="aria-label" data-es="Descargar CV en español" data-en="Download CV in Spanish">
      <span class="btn-icon" aria-hidden="true">↓</span>
      <span>CV (ES)</span>
    </a>
    <div class="ct-links">
      <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </div>
  </div>

  <T t={contact.note} as="p" class="ct-note" />
</section>
