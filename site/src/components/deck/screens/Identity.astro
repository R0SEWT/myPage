---
import { SCREENS, identity, links } from '../../../data/deck';
import T from '../T.astro';

const s = SCREENS[0];
---
<section class="screen" data-num={s.num} data-es={s.label.es} data-en={s.label.en}>
  <h1 class="id-row">
    <T t={identity.wordLeft} class="id-word" />
    <T t={identity.wordRight} class="id-word id-word--right" />
  </h1>

  <div class="id-foot">
    <div class="id-blurb">
      <T t={identity.blurb} as="p" />
      <div class="chips">
        {identity.chips.map((c) => <span class="chip">{c}</span>)}
      </div>
    </div>

    <div class="id-card">
      <div><b>{identity.name}</b></div>
      <div>{identity.role}</div>
      <div class="id-links">
        <a href={`mailto:${links.email}`}>Email ↗</a>
        <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
    </div>
  </div>
</section>
