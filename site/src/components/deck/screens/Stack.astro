---
import { SCREENS, stack } from '../../../data/deck';
import T from '../T.astro';

const s = SCREENS[5];
---
<section
  class="screen screen--stack"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <div class="sec-head"><T t={s.label} /></div>

  <div class="stack-grid">
    {stack.map((col) => (
      <div>
        <div class="stack-title">{col.title}</div>
        <div class="stack-list">
          {col.items.map((it) => <span>{it}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>
