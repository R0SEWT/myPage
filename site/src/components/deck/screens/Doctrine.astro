---
import { SCREENS, doctrine } from '../../../data/deck';
import T from '../T.astro';

const s = SCREENS[1];
---
<section
  class="screen screen--sheet"
  data-num={s.num}
  data-es={s.label.es}
  data-en={s.label.en}
  hidden
>
  <div class="sheet">
    <div class="sheet-grid">
      <div>
        <T t={doctrine.eyebrow} as="div" class="sheet-eyebrow" />
        <T t={doctrine.lede} as="p" class="sheet-lede" />
      </div>

      <div class="sheet-side">
        {doctrine.notes.map((n) => (
          <div>
            <div class="note-num">{n.num}</div>
            <T t={n.body} as="p" class="note-body" />
          </div>
        ))}
        <blockquote class="quote">
          <T t={doctrine.quote} />
          <cite>{doctrine.cite}</cite>
        </blockquote>
      </div>
    </div>
  </div>
</section>
