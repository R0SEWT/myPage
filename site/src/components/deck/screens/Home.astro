---
import { SCREENS, chrome, home, links } from '../../../data/deck';
import T from '../T.astro';
import TelemetryHud from '../TelemetryHud.astro';

const s = SCREENS[0];
---
<section class="screen" data-num={s.num} data-es={s.label.es} data-en={s.label.en}>
  <div class="id-kicker">
    <span class="kicker-dot" aria-hidden="true"></span>
    <T t={home.kicker} />
  </div>

  <h1 class="id-row">
    <T t={home.wordLeft} class="id-word" />
    <T t={home.wordRight} class="id-word id-word--right" />
  </h1>

  <div class="id-foot">
    <div class="id-blurb">
      <T t={home.blurb} as="p" />
      <div class="chips">
        {home.chips.map((c) => (
          <button type="button" class="chip" data-go="1" aria-label="Ver sistemas">
            <T t={c} />
          </button>
        ))}
      </div>
    </div>

    <div class="id-card">
      <div class="id-name"><b>{home.name}</b></div>
      <div class="id-role">{home.role}</div>
      <div class="id-org">{home.org}</div>

      <div class="id-actions">
        <div class="id-cv-row">
          <a class="btn-recruiter" href={links.cvEn} download="Rody-Vilchez-CV-en.pdf" aria-label="Download CV in English">
            <span class="btn-icon" aria-hidden="true">↓</span>
            <span>CV (EN)</span>
          </a>
          <a class="btn-recruiter" href={links.cvEs} download="Rody-Vilchez-CV-es.pdf" aria-label="Descargar CV en Español">
            <span class="btn-icon" aria-hidden="true">↓</span>
            <span>CV (ES)</span>
          </a>
        </div>
        <button type="button" class="btn-recruiter btn-recruiter--action" data-go="1" aria-label="Ver sistemas">
          <span class="btn-icon" aria-hidden="true">→</span>
          <T t={{ es: 'Ver Sistemas', en: 'View Systems' }} />
        </button>
      </div>

      <div class="id-links">
        <span class="copy-wrap">
          <a href={`mailto:${links.email}`} data-copy={links.email}>Email ↗</a>
          <span class="copy-live" role="status"><T t={chrome.copied} class="copy-flag" /></span>
        </span>
        <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>

      <TelemetryHud />
    </div>
  </div>
</section>
