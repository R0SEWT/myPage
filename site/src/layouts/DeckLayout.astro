---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/vesper.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  robots?: string;
}

const { title, description, jsonLd = [], robots = 'index, follow, max-snippet:-1, max-image-preview:large' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og-image.png', Astro.site);
---
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- The .ico is declared alone, without the old favicon.svg beside it:
         browsers that support SVG prefer it, so keeping both would mean this
         mark almost never shows. favicon.svg is still on disk. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <meta name="author" content="Rody Vilchez" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="help" type="text/markdown" href="/llms.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rody Vilchez, Applied ML Engineer — Systems in use" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Rody Vilchez" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Rody Vilchez, Applied ML Engineer — Systems in use" />
    {jsonLd.map((obj) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    <noscript>
      <style>
        /* Without JS the boot overlay never clears and the deck never advances,
           so drop the chrome and let every screen stack into one scroll. */
        #boot,
        #stats,
        #more { display: none !important; }
        /* Undo the stacked grid: with no JS to drive the crossfade, every
           screen is shown at full opacity in one long scroll. */
        .pane { display: block; }
        .screen[hidden] { display: block !important; }
        .screen { opacity: 1; margin: 0 0 96px; }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
