---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Rody Vilchez" description="The page you are looking for does not exist." robots="noindex, follow">
  <main class="not-found">
    <p class="not-found__eyebrow">ERROR / 404</p>
    <h1>Signal lost.</h1>
    <p>The requested system does not exist at this address.</p>
    <a href="/">← Return to the deck</a>
  </main>
</BaseLayout>

<style>
  /*
   * The error page belongs to the deck, not to the case studies: its only exit
   * is back to `/`. It borrows the Vesper palette by value rather than by
   * token, because `vesper.css` is loaded by DeckLayout and this page runs on
   * BaseLayout. The hexes are the ones vesper.css declares — --v-green,
   * --v-violet, --v-ink and the --v-dim ramp. Fonts do come from tokens.css,
   * whose stacks are already identical.
   */
  .not-found { min-height: 100svh; display: grid; align-content: center; gap: 1.25rem; width: min(76rem, calc(100% - 3rem)); margin: auto; }
  .not-found::before { content: ''; position: fixed; inset: 0; z-index: -1; background: radial-gradient(circle at 72% 35%, rgba(139, 123, 255, .22), transparent 34%), radial-gradient(circle at 30% 65%, rgba(59, 224, 166, .12), transparent 28%), #000; }
  .not-found__eyebrow { color: #3be0a6; font: 500 .75rem/1 var(--font-mono); letter-spacing: .18em; }
  /*
   * `line-height: .82` sets a line box shorter than the font's own bounding
   * box, so the ink overruns the box below by ~0.1724em — at the top of the
   * clamp that is 30px, and the descender of a "g" crosses the paragraph. The
   * padding is in `em` so it tracks the clamp instead of a single width.
   */
  h1 { margin: 0; padding-bottom: .19em; color: #edefee; font: 500 clamp(4.5rem, 14vw, 11rem)/.82 var(--font-sans); letter-spacing: -.07em; }
  p { max-width: 35rem; color: #9ba3a1; font-family: var(--font-mono); }
  a { width: fit-content; margin-top: 1rem; color: #b9c0be; font-family: var(--font-mono); border-bottom: 1px solid #3be0a6; }
</style>
