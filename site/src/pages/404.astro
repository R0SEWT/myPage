---
import DeckLayout from '../layouts/DeckLayout.astro';
---
<DeckLayout title="404 — Rody Vilchez" description="The page you are looking for does not exist." robots="noindex, follow" lang="en" doc>
  <div class="doc-backdrop" aria-hidden="true"></div>
  <main class="not-found">
    <p class="doc-eyebrow">Error / 404</p>
    <h1>Signal lost.</h1>
    <p>The requested system does not exist at this address.</p>
    <a href="/">← Return to the deck</a>
  </main>
</DeckLayout>

<style>
  /* Now on the deck's own layout, so it reads the Vesper tokens instead of
     copying their hex values. */
  .not-found {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 1.25rem;
    width: min(60rem, calc(100% - 2.75rem));
    margin: auto;
  }
  /* `line-height: .82` sets a line box shorter than the ink; the em padding
     keeps the descender of the "g" off the paragraph at every clamp size. */
  h1 {
    margin: 0;
    padding-bottom: 0.19em;
    color: var(--v-ink);
    font: 500 clamp(3.6rem, 11vw, 8.8rem) / 0.82 var(--v-sans);
    letter-spacing: -0.07em;
  }
  p:not(.doc-eyebrow) {
    max-width: 28rem;
    margin: 0;
    color: var(--v-dim-1);
    font-family: var(--v-mono);
    font-size: 0.75rem;
  }
  a {
    width: fit-content;
    margin-top: 0.75rem;
    padding: 0.3125rem 0;
    color: var(--v-ink);
    font-family: var(--v-mono);
    font-size: 0.75rem;
    border-bottom: 1px solid var(--v-green);
  }
</style>
