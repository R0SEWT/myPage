# Private evidence vault
.cv-vault/
**/node_modules/
**/.vite/
**/.venv/
**/__pycache__/
*.pyc
**/.DS_Store
# Playwright MCP run artifacts (screenshots, snapshots, console logs)
**/.playwright-mcp/
# SuperDesign temporary component templates
.superdesign/tmp/
# Local LaTeX build artifacts for the CV
cv/*.aux
cv/**/*.aux
cv/**/*.fdb_latexmk
cv/**/*.fls
cv/**/*.log
cv/**/*.out
cv/**/*.synctex.gz
cv/**/*.toc
cv/**/*.xdv
# Build output. The published pair is committed at site/public/CV.*.pdf.
cv/**/*.pdf

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
